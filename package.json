{
  "name": "next-security-new",
  "version": "3.0.0-rc.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "homepage": "https://github.com/raliclo/nuxt-security#readme",
  "description": "Nuxt security module fork with runtime hardening and compatibility regressions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raliclo/nuxt-security.git"
  },
  "bugs": { "url": "https://github.com/raliclo/nuxt-security/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/", "tag": "next" },
  "keywords": [
    "nuxt",
    "vue",
    "security",
    "owasp",
    "helmet",
    "basic-auth",
    "rate-limit",
    "xss",
    "cors",
    "request-size-limit",
    "allowed-http-methods",
    "csrf",
    "content-security-policy"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "files": [
    "dist",
    "PUBLISHING.md"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:start": "nuxi start playground",
    "dev:generate": "nuxi generate playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "dev:preview": "nuxi preview playground",
    "dev:docs": "rm -rf dist && cd docs && yarn dev",
    "lint": "eslint .",
    "release": "yarn lint && yarn test --maxWorkers=2 && yarn prepack",
    "test": "vitest run --silent",
    "test:watch": "vitest watch",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "stackblitz": "cd .stackblitz && yarn && yarn dev"
  },
  "packageManager": "yarn@1.22.19",
  "dependencies": {
    "@nuxt/kit": "~4.6.4",
    "basic-auth": "^3.1.0",
    "defu": "^6.1.7",
    "lru-cache": "^11.2.6",
    "nuxt-csurf": "^1.6.5",
    "pathe": "^2.0.3",
    "radix3": "^1.1.2",
    "unplugin-remove": "^1.0.3",
    "xss": "^1.0.15",
    "redis": "^6.4.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@nuxt/cli": "^4.1.0",
    "@nuxt/eslint-config": "^0.3.10",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "~4.6.4",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^24.10.1",
    "changelogen": "^0.6.2",
    "eslint": "^8.57.0",
    "nuxi": "^4.1.0",
    "nuxt": "~4.6.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "vite": "^8.3.8",
    "rolldown": "~1.2.19",
    "vue": "^3.5.46",
    "@vue/compiler-core": "^3.5.46",
    "esbuild": "^0.28.2",
    "nitro": "3.0.261103-rc",
    "miniflare": "4.20260730.0",
    "@playwright/test": "^1.56.1"
  },
  "stackblitz": {
    "installDependencies": false,
    "startCommand": "yarn stackblitz"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "unbuild": {
    "entries": [
      "./src/utils/crypto.ts",
      "./src/utils/headers.ts",
      "./src/utils/merge.ts",
      "./src/utils/nonce.ts",
      "./src/utils/xss.ts",
      "./src/utils/prerenderedHeaders.ts",
      "./src/utils/extensions.ts",
      "./src/utils/limitedBody.ts",
      "./src/utils/rateLimit.ts",
      "./src/utils/runtimeOverrides.ts",
      "./src/defaultConfig.ts"
    ],
    "externals": [
      "unstorage"
    ]
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.5" },
    "eslint-plugin-import-x": { "minimatch": "^11.0.5" },
    "readdir-glob": { "minimatch": "^11.0.5" },
    "miniflare": { "undici": "^7.30.1", "sharp": "^0.35.5" }
  },
  "resolutions": {
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.5",
    "**/eslint-plugin-import-x/minimatch": "^11.0.5",
    "**/readdir-glob/minimatch": "^11.0.5",
    "**/miniflare/undici": "^7.30.1",
    "**/miniflare/sharp": "^0.35.5"
  }
}
